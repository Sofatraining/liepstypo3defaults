##Produziert Title aus Pagetitel und Webseitentitel - z.B.: <title>Bootsmotoren :: Müritz-Yacht Management - MYM</title>
page = PAGE
page {
  config.noPageTitle = 2
  headerData {
    10 = COA
    10 {
      # 10 = Titel (Event/News in Detail -> TitleTagResolver, sonst SEO-Titel oder Seitentitel)
      10 = USER
      10.userFunc = LiepsGmbH\Liepstypo3defaults\Seo\TitleTagResolver->resolve
      10.stdWrap.htmlSpecialChars = 1
      10.stdWrap.ifEmpty.field = seo_title
      10.stdWrap.ifEmpty.cObject = TEXT
      10.stdWrap.ifEmpty.cObject.field = title

      20 = TEXT
      20.value = ::
      20.noTrimWrap = | | |

      30 = TEXT
      30.data = siteLanguage:websiteTitle
      30.ifEmpty.data = site:websiteTitle

      wrap = <title>|</title>
    }
  }
}

